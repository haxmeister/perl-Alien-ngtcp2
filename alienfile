use alienfile 2.88;

plugin 'PkgConfig' => (
    pkg_name        => 'libngtcp2',
    atleast_version => '1.25.0',
);

share {
    start_url 'https://github.com/ngtcp2/ngtcp2/releases/download/v1.25.0/ngtcp2-1.25.0.tar.xz';

    plugin 'Digest' => [
        SHA256 => '2a34d2484ba17847a5d11965704e9dd0fac4c6d8efc75ffe1ec7de66d8c6b6fb',
    ];
    plugin 'Download';
    plugin 'Extract' => 'tar.xz';

    if ($^O eq 'MSWin32') {
        plugin 'Build::CMake';

        build [
            [
                '%{cmake}',
                @{ meta->prop->{plugin_build_cmake}->{args} },
                '-DENABLE_LIB_ONLY=ON',
                '-DENABLE_SHARED_LIB=OFF',
                '-DENABLE_STATIC_LIB=ON',
                '-DENABLE_OPENSSL=OFF',
                '-DBUILD_TESTING=OFF',
                '%{.install.extract}',
            ],
            '%{make}',
            '%{make} install',
        ];
    }
    else {
        plugin 'Build::Autoconf';

        build [
            '%{configure} --enable-lib-only --disable-crypto --disable-shared --enable-static',
            '%{make}',
            '%{make} install',
        ];
    }
};
